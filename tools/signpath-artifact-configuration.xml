<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration: the workflow artifact is a zip holding Campfire.exe, which gets an Authenticode signature. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Campfire.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
