<Window x:Class="PCLPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCL++"
        Width="640"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        AllowDrop="True"
        FontFamily="{StaticResource FontMain}"
        FontSize="13"
        Foreground="{StaticResource Brush1}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <DataTemplate x:Key="PatchRowTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="22" Height="22" Margin="0,0,12,0" CornerRadius="11"
                        VerticalAlignment="Center" BorderThickness="1.5" BorderBrush="{Binding Accent}">
                    <Path Width="16" Height="16" Stretch="None" Data="{Binding Icon}"
                          Stroke="{Binding Accent}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" />
                    <TextBlock Margin="0,1,0,0" FontSize="12" Foreground="{StaticResource BrushGray4}"
                               Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{Binding Accent}" Text="{Binding StateText}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Outer margin leaves room for the window shadow. -->
    <Border Margin="12" CornerRadius="6" Background="{StaticResource BrushBackground}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" Color="#1B3A66" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ======================== Title bar ======================== -->
            <Border x:Name="PanTitle" Background="{StaticResource BrushTitleBar}" CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="PanTitle_MouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="28" Height="28" Source="Assets/Logo.png"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="PCL++" FontSize="19"
                                   FontWeight="Bold" Foreground="{StaticResource BrushWhite}" />
                        <Border Margin="12,1,0,0" Padding="7,1" VerticalAlignment="Center" CornerRadius="3"
                                Background="{StaticResource BrushHalfWhite}">
                            <TextBlock Text="修复工具" FontSize="12" Foreground="{StaticResource BrushWhite}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnMinimize" Style="{StaticResource PclTitleBarButton}" ToolTip="最小化"
                                Click="BtnMinimize_Click">
                            <Path Data="M0,0 L10,0" Stroke="{StaticResource BrushWhite}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <Button x:Name="BtnClose" Margin="4,0,0,0" Style="{StaticResource PclTitleBarButton}"
                                ToolTip="关闭" Click="BtnClose_Click">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource BrushWhite}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Both pages share one cell; the inactive one is Hidden, so the window keeps a stable height. -->
            <Grid Grid.Row="1">

            <!-- ======================== Main page ======================== -->
            <StackPanel x:Name="PanMain" Margin="22,20,22,18">

                <HeaderedContentControl Header="启动器" Style="{StaticResource PclCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="LabFileName" FontSize="14" Text="未选择启动器" />
                                    <Border x:Name="PanVersion" Margin="8,0,0,0" Padding="6,0" CornerRadius="3"
                                            VerticalAlignment="Center" Background="{StaticResource Brush7}"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="LabVersion" FontSize="12" Foreground="{StaticResource Brush3}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="LabFilePath" Margin="0,3,0,0" FontSize="12"
                                           Foreground="{StaticResource BrushGray4}" TextTrimming="CharacterEllipsis"
                                           Text="点击右侧按钮选择 Plain Craft Launcher 2.exe，或直接把它拖到本窗口" />
                            </StackPanel>
                            <Button x:Name="BtnBrowse" Grid.Column="1" Margin="16,0,0,0" Content="选择文件"
                                    Style="{StaticResource PclButton}" Click="BtnBrowse_Click" />
                        </Grid>

                        <ContentControl x:Name="HintStatus" Margin="0,14,0,0" Style="{StaticResource PclHint}">
                            <TextBlock x:Name="LabStatus" TextWrapping="Wrap" Text="正在查找启动器……" />
                        </ContentControl>

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <Button x:Name="BtnOpenFolder" Content="打开所在文件夹" Style="{StaticResource PclTextButton}"
                                    IsEnabled="False" Click="BtnOpenFolder_Click" />
                            <Button x:Name="BtnLaunch" Margin="16,0,0,0" Content="启动 PCL"
                                    Style="{StaticResource PclTextButton}" Visibility="Collapsed"
                                    Click="BtnLaunch_Click" />
                        </StackPanel>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Margin="0,15,0,0" Header="修复内容" Style="{StaticResource PclCard}">
                    <ItemsControl x:Name="ListPatches" Focusable="False"
                                  ItemTemplate="{StaticResource PatchRowTemplate}" />
                </HeaderedContentControl>

                <Grid Margin="0,18,0,0">
                    <Button x:Name="BtnAbout" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Style="{StaticResource PclTextButton}" Foreground="{StaticResource BrushGray4}"
                            ToolTip="版本、作者与开源仓库" Click="BtnAbout_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="15" Height="15" CornerRadius="7.5" BorderThickness="1.3"
                                    BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Path Data="M0,0 L0,0.2 M0,2 L0,5.5" Stretch="None" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" StrokeThickness="1.4" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Border>
                            <TextBlock Margin="6,0,0,0" Text="关于" />
                        </StackPanel>
                    </Button>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="BtnRestore" Content="还原" Style="{StaticResource PclButton}"
                                IsEnabled="False" ToolTip="用备份文件恢复修复前的启动器" Click="BtnRestore_Click" />
                        <Button x:Name="BtnFix" Margin="12,0,0,0" MinWidth="140" Content="一键修复" FontWeight="Bold"
                                Style="{StaticResource PclButtonHighlight}" IsEnabled="False" Click="BtnFix_Click" />
                    </StackPanel>
                </Grid>

            </StackPanel>

            <!-- ======================== About page ======================== -->
            <StackPanel x:Name="PanAbout" Margin="22,20,22,18" Visibility="Hidden">

                <HeaderedContentControl Header="关于" Style="{StaticResource PclCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="56" Height="56" CornerRadius="6" ClipToBounds="True">
                                <Border.Background>
                                    <ImageBrush ImageSource="Assets/Logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border.Background>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="PCL++" FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource Brush3}" />
                                    <Border Margin="10,2,0,0" Padding="6,0" CornerRadius="3" VerticalAlignment="Center"
                                            Background="{StaticResource Brush7}">
                                        <TextBlock x:Name="LabAboutVersion" FontSize="12"
                                                   Foreground="{StaticResource Brush3}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{StaticResource BrushGray3}"
                                           Text="PCL 正式版的增强与修复工具，开源免费。" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="36" Height="36" Stroke="{StaticResource Brush6}" StrokeThickness="1">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="Assets/Avatar.jpg" Stretch="UniformToFill"
                                                RenderOptions.BitmapScalingMode="HighQuality" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Xocio" />
                                <TextBlock Margin="0,1,0,0" FontSize="12" Foreground="{StaticResource BrushGray4}"
                                           Text="作者 · github.com/Xocio" />
                            </StackPanel>
                            <Button Grid.Column="2" MinWidth="88" Height="30" Content="主页"
                                    Style="{StaticResource PclButton}" Tag="https://github.com/Xocio"
                                    Click="LinkButton_Click" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource Brush7}">
                                <Path Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource Brush3}"
                                      Data="M8,0 C3.58,0 0,3.58 0,8 C0,11.54 2.29,14.53 5.47,15.59 C5.87,15.66 6.02,15.42 6.02,15.21 C6.02,15.02 6.01,14.39 6.01,13.72 C4,14.09 3.48,13.23 3.32,12.78 C3.23,12.55 2.84,11.84 2.5,11.65 C2.22,11.5 1.82,11.13 2.49,11.12 C3.12,11.11 3.57,11.7 3.72,11.94 C4.44,13.15 5.59,12.81 6.05,12.6 C6.12,12.08 6.33,11.73 6.56,11.53 C4.78,11.33 2.92,10.64 2.92,7.58 C2.92,6.71 3.23,5.99 3.74,5.43 C3.66,5.23 3.38,4.41 3.82,3.31 C3.82,3.31 4.49,3.1 6.02,4.13 C6.66,3.95 7.34,3.86 8.02,3.86 C8.7,3.86 9.38,3.95 10.02,4.13 C11.55,3.09 12.22,3.31 12.22,3.31 C12.66,4.41 12.38,5.23 12.3,5.43 C12.81,5.99 13.12,6.7 13.12,7.58 C13.12,10.65 11.25,11.33 9.47,11.53 C9.76,11.78 10.01,12.26 10.01,13.01 C10.01,14.08 10,14.94 10,15.21 C10,15.42 10.15,15.67 10.55,15.59 C13.71,14.53 16,11.53 16,8 C16,3.58 12.42,0 8,0 Z" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Xocio/PCLPlus" />
                                <TextBlock Margin="0,1,0,0" FontSize="12" Foreground="{StaticResource BrushGray4}"
                                           Text="源代码、问题反馈与新版本下载" />
                            </StackPanel>
                            <Button Grid.Column="2" MinWidth="88" Height="30" Content="仓库"
                                    Style="{StaticResource PclButtonHighlight}" Tag="https://github.com/Xocio/PCLPlus"
                                    Click="LinkButton_Click" />
                        </Grid>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Margin="0,15,0,0" Header="说明" Style="{StaticResource PclCard}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushGray3}"
                                   Text="· PCL++ 是社区项目，与 PCL 及其作者无关。" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource BrushGray3}"
                                   Text="· 修复只在本机进行，不上传、不下载任何文件；原启动器会自动备份，可随时还原。" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource BrushGray3}"
                                   Text="· 修复后启动器不再自动更新，升级 PCL 后请重新运行 PCL++。" />
                    </StackPanel>
                </HeaderedContentControl>

                <Grid Margin="0,18,0,0">
                    <Button HorizontalAlignment="Right" Content="返回" Style="{StaticResource PclButton}"
                            Click="BtnBack_Click" />
                </Grid>

            </StackPanel>

            </Grid>
        </Grid>
    </Border>
</Window>
