<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Blue theme palette, from darkest (1) to lightest (8). -->
    <Color x:Key="Color1">#343D4A</Color>
    <Color x:Key="Color2">#0B5BCB</Color>
    <Color x:Key="Color3">#1370F3</Color>
    <Color x:Key="Color4">#4890F5</Color>
    <Color x:Key="Color5">#96C0F9</Color>
    <Color x:Key="Color6">#D5E6FD</Color>
    <Color x:Key="Color7">#E0EAFD</Color>
    <Color x:Key="Color8">#EAF2FE</Color>

    <SolidColorBrush x:Key="Brush1" Color="{StaticResource Color1}" />
    <SolidColorBrush x:Key="Brush2" Color="{StaticResource Color2}" />
    <SolidColorBrush x:Key="Brush3" Color="{StaticResource Color3}" />
    <SolidColorBrush x:Key="Brush4" Color="{StaticResource Color4}" />
    <SolidColorBrush x:Key="Brush5" Color="{StaticResource Color5}" />
    <SolidColorBrush x:Key="Brush6" Color="{StaticResource Color6}" />
    <SolidColorBrush x:Key="Brush7" Color="{StaticResource Color7}" />
    <SolidColorBrush x:Key="Brush8" Color="{StaticResource Color8}" />

    <SolidColorBrush x:Key="BrushGray1" Color="#404040" />
    <SolidColorBrush x:Key="BrushGray3" Color="#737373" />
    <SolidColorBrush x:Key="BrushGray4" Color="#8C8C8C" />
    <SolidColorBrush x:Key="BrushGray5" Color="#A6A6A6" />
    <SolidColorBrush x:Key="BrushGray7" Color="#E0E0E0" />

    <SolidColorBrush x:Key="BrushWhite" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushCard" Color="#CDFFFFFF" />
    <SolidColorBrush x:Key="BrushCardHover" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="BrushHalfWhite" Color="#55FFFFFF" />

    <SolidColorBrush x:Key="BrushGreen" Color="#1E9E58" />
    <SolidColorBrush x:Key="BrushGreenLight" Color="#E3F5EA" />
    <SolidColorBrush x:Key="BrushRed" Color="#D82929" />
    <SolidColorBrush x:Key="BrushRedLight" Color="#FDE8E8" />

    <LinearGradientBrush x:Key="BrushTitleBar" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{StaticResource Color2}" />
        <GradientStop Offset="0.5" Color="{StaticResource Color3}" />
        <GradientStop Offset="1" Color="{StaticResource Color2}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushBackground" StartPoint="0.1,0" EndPoint="0.9,1">
        <GradientStop Offset="0" Color="#E8F0FC" />
        <GradientStop Offset="0.5" Color="#D9E6F9" />
        <GradientStop Offset="1" Color="#C9DBF6" />
    </LinearGradientBrush>

    <!-- "Microsoft YaHei UI" ships with Windows 8+; Windows 7 falls back to "Microsoft YaHei". -->
    <FontFamily x:Key="FontMain">Microsoft YaHei UI, Microsoft YaHei, Segoe UI, SimSun</FontFamily>

</ResourceDictionary>
