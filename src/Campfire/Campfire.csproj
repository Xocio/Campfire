<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Campfire</RootNamespace>
    <AssemblyName>Campfire</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Campfire.ico</ApplicationIcon>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <Product>Campfire</Product>
    <AssemblyTitle>Campfire</AssemblyTitle>
    <Company>Xocio</Company>
    <Authors>Xocio</Authors>
    <Description>An advanced Minecraft toolbox.</Description>
    <Version>1.1.0</Version>
    <Copyright>Copyright © 2026 Xocio</Copyright>
    <RepositoryUrl>https://github.com/Xocio/Campfire</RepositoryUrl>
  </PropertyGroup>

  <!-- Release: optimized, no debug data, reproducible, single file. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <!-- The PE header already targets CLR 4; no Campfire.exe.config is needed next to the executable. -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- dnlib ships inside Campfire.exe (see EmbedDependencies), never next to it. -->
    <PackageReference Include="dnlib" Version="4.4.0" GeneratePathProperty="true" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Management" />
  </ItemGroup>

  <!--
    Update and notice service. Only official builds pass it (dotnet build -p:ServiceUrl=https://...);
    without it Campfire never contacts the service.
  -->
  <ItemGroup Condition="'$(ServiceUrl)' != ''">
    <AssemblyMetadata Include="ServiceUrl" Value="$(ServiceUrl)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\CampfireFrames.png" />
    <Resource Include="Assets\Avatar.jpg" />
    <!--
      The Java agent and its attach bridge are built from java-agent/ and embedded in Campfire.exe.
      They add the room header, footer and welcome message from inside the host's own server, which
      also works when the LAN login is encrypted.
    -->
    <EmbeddedResource Include="..\java-agent\dist\CampfireAgent.jar" LogicalName="Campfire.CampfireAgent.jar" />
    <EmbeddedResource Include="..\java-agent\dist\CampfireHook.jar" LogicalName="Campfire.CampfireHook.jar" />
    <EmbeddedResource Include="..\java-agent\dist\CampfireAttach.jar" LogicalName="Campfire.CampfireAttach.jar" />
  </ItemGroup>

  <!--
    Packs embedded dependencies into one deflate-compressed archive before compilation.
    EmbeddedAssemblyLoader reads "<name>.dll" entries from it on demand.
  -->
  <PropertyGroup>
    <EmbedStagingDir>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)$(Configuration)\embedded\</EmbedStagingDir>
    <EmbedArchive>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)$(Configuration)\dependencies.zip</EmbedArchive>
  </PropertyGroup>

  <Target Name="EmbedDependencies" BeforeTargets="BeforeBuild"
          Inputs="$(Pkgdnlib)\lib\net45\dnlib.dll" Outputs="$(EmbedArchive)">
    <RemoveDir Directories="$(EmbedStagingDir)" />
    <Copy SourceFiles="$(Pkgdnlib)\lib\net45\dnlib.dll" DestinationFolder="$(EmbedStagingDir)" />
    <ZipDirectory SourceDirectory="$(EmbedStagingDir)" DestinationFile="$(EmbedArchive)" Overwrite="true" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="$(EmbedArchive)" LogicalName="Campfire.Dependencies.zip" Visible="false" />
  </ItemGroup>

</Project>
