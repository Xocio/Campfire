<UserControl x:Class="Campfire.Controls.RoomBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Campfire.Localization"
             Cursor="Hand" Focusable="False" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
             ToolTip="{loc:Text Home.ViewRoom}">
    <UserControl.RenderTransform>
        <ScaleTransform x:Name="Zoom" />
    </UserControl.RenderTransform>

    <Grid>
        <!-- Faint rings around the edge in place of a shadow. -->
        <Grid x:Name="PanRings" IsHitTestVisible="False">
            <Border Margin="-4" CornerRadius="28" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.12" />
            <Border Margin="-3" CornerRadius="27" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.25" />
            <Border Margin="-2" CornerRadius="26" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.45" />
            <Border Margin="-1" CornerRadius="25" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.75" />
        </Grid>
        <Border CornerRadius="24" Background="{DynamicResource BrushSurface}" />
        <Border x:Name="PanHover" CornerRadius="24" Background="{DynamicResource Brush8}" Opacity="0" />

        <Grid x:Name="PanContent" Height="48" MinWidth="150" MaxWidth="260" Margin="16,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="DotRoom" Width="8" Height="8" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="LabTitle" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Brush1}" />
                <TextBlock x:Name="LabDetail" Margin="0,1,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource BrushGray4}" />
            </StackPanel>
            <Border Grid.Column="2" Width="32" Height="32" CornerRadius="16" VerticalAlignment="Center"
                    Background="{DynamicResource Brush7}">
                <!-- An arrow into the room. -->
                <Path Width="16" Height="16" Stretch="None" Data="M4,8 L12,8 M8.5,4.5 L12,8 L8.5,11.5"
                      Stroke="{DynamicResource Brush3}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
