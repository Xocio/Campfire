<UserControl x:Class="Campfire.Controls.TourOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Campfire.Controls"
             Visibility="Collapsed"
             Focusable="True"
             FocusVisualStyle="{x:Null}">

    <Grid x:Name="Root">
        <controls:TourSpotlight x:Name="Spot" Accent="{DynamicResource Brush4}" />

        <!-- The card is placed with a render transform, so moving it never triggers a layout pass. -->
        <Canvas>
            <Grid x:Name="Card" Width="360" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform />
                        <TranslateTransform />
                    </TransformGroup>
                </Grid.RenderTransform>

                <Grid IsHitTestVisible="False">
                    <Border Margin="-6" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.08" />
                    <Border Margin="-5" CornerRadius="11" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.14" />
                    <Border Margin="-4" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.22" />
                    <Border Margin="-3" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.34" />
                    <Border Margin="-2" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.52" />
                    <Border Margin="-1" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.8" />
                </Grid>
                <Border CornerRadius="6" Background="{DynamicResource BrushSurface}" />

                <!-- Points at the element on show; it slides along the card edge as the spotlight moves. -->
                <Border x:Name="Arrow" Width="12" Height="12" Margin="0,-5,0,0" HorizontalAlignment="Left"
                        VerticalAlignment="Top" IsHitTestVisible="False" Background="{DynamicResource BrushSurface}"
                        RenderTransformOrigin="0.5,0.5" CornerRadius="2">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <RotateTransform Angle="45" />
                            <TranslateTransform />
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>

                <StackPanel Margin="22,18,22,16">
                    <Grid x:Name="Host" Height="60" ClipToBounds="True" />
                    <Grid Margin="0,14,0,0" Height="32">
                        <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnPrev" Height="32" MinWidth="68" Focusable="False" Style="{StaticResource PclButton}"
                                    Visibility="Collapsed" Click="BtnPrev_Click" />
                            <Button x:Name="BtnNext" Height="32" MinWidth="88" Margin="8,0,0,0" FontWeight="Bold" Focusable="False"
                                    Style="{StaticResource PclButtonHighlight}" Click="BtnNext_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Button x:Name="BtnSkip" Margin="0,16,18,0" HorizontalAlignment="Right" VerticalAlignment="Top" Focusable="False"
                        Style="{StaticResource PclTextButton}" Click="BtnSkip_Click" />
            </Grid>
        </Canvas>
    </Grid>
</UserControl>
