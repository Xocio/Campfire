<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Starting values of the theme. At startup the theme manager replaces every color below with ones built from
        the chosen key color (light or dark), so these only matter before that happens.
        Brush1 is the main text color; Brush2 to Brush8 go from the strongest accent to the lightest tint.
    -->
    <Color x:Key="Color1">#4A3A30</Color>
    <Color x:Key="Color2">#B84A06</Color>
    <Color x:Key="Color3">#E2680C</Color>
    <Color x:Key="Color4">#F08F3C</Color>
    <Color x:Key="Color5">#F7C496</Color>
    <Color x:Key="Color6">#FCE3CE</Color>
    <Color x:Key="Color7">#FDEADB</Color>
    <Color x:Key="Color8">#FEF2E8</Color>
    <Color x:Key="ColorShadow">#5C2C0A</Color>

    <SolidColorBrush x:Key="Brush1" Color="{StaticResource Color1}" />
    <SolidColorBrush x:Key="Brush2" Color="{StaticResource Color2}" />
    <SolidColorBrush x:Key="Brush3" Color="{StaticResource Color3}" />
    <SolidColorBrush x:Key="Brush4" Color="{StaticResource Color4}" />
    <SolidColorBrush x:Key="Brush5" Color="{StaticResource Color5}" />
    <SolidColorBrush x:Key="Brush6" Color="{StaticResource Color6}" />
    <SolidColorBrush x:Key="Brush7" Color="{StaticResource Color7}" />
    <SolidColorBrush x:Key="Brush8" Color="{StaticResource Color8}" />

    <SolidColorBrush x:Key="BrushGray1" Color="#404040" />
    <SolidColorBrush x:Key="BrushGray3" Color="#737373" />
    <SolidColorBrush x:Key="BrushGray4" Color="#8C8C8C" />
    <SolidColorBrush x:Key="BrushGray5" Color="#A6A6A6" />
    <SolidColorBrush x:Key="BrushGray7" Color="#E0E0E0" />

    <!-- Text and icons on the title bar, which stays colored in both light and dark mode. -->
    <SolidColorBrush x:Key="BrushWhite" Color="#FFFFFF" />
    <!-- Text and ticks drawn on an accent fill, and the accent text on the selected title bar tab. -->
    <SolidColorBrush x:Key="BrushOnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushTitleAccent" Color="#E2680C" />

    <SolidColorBrush x:Key="BrushSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushCard" Color="#CDFFFFFF" />
    <SolidColorBrush x:Key="BrushCardHover" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="BrushTile" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="BrushInput" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="BrushInputFocus" Color="#FFFFFF" />

    <SolidColorBrush x:Key="BrushGreen" Color="#1E9E58" />
    <SolidColorBrush x:Key="BrushGreenLight" Color="#E3F5EA" />
    <SolidColorBrush x:Key="BrushRed" Color="#D82929" />
    <SolidColorBrush x:Key="BrushRedLight" Color="#FDE8E8" />
    <SolidColorBrush x:Key="BrushOrange" Color="#B86200" />
    <SolidColorBrush x:Key="BrushOrangeLight" Color="#FDF1E0" />
    <SolidColorBrush x:Key="BrushDialogMask" Color="#66402614" />
    <!-- Faint outlines drawn around cards and the window as their shadow. -->
    <SolidColorBrush x:Key="BrushShadowRing" Color="#305C2C0A" />

    <LinearGradientBrush x:Key="BrushTitleBar" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{StaticResource Color2}" />
        <GradientStop Offset="0.5" Color="{StaticResource Color3}" />
        <GradientStop Offset="1" Color="{StaticResource Color2}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushBackground" StartPoint="0.1,0" EndPoint="0.9,1">
        <GradientStop Offset="0" Color="#FCF3EA" />
        <GradientStop Offset="0.5" Color="#F9E8D8" />
        <GradientStop Offset="1" Color="#F5DCC4" />
    </LinearGradientBrush>

    <!-- Code-like text, such as invite codes and addresses. -->
    <FontFamily x:Key="FontCode">Consolas, Microsoft YaHei UI, Microsoft YaHei</FontFamily>

    <!-- "Microsoft YaHei UI" ships with Windows 8+; Windows 7 falls back to "Microsoft YaHei". -->
    <FontFamily x:Key="FontMain">Microsoft YaHei UI, Microsoft YaHei, Segoe UI, SimSun</FontFamily>

</ResourceDictionary>
