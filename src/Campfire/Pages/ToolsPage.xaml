<UserControl x:Class="Campfire.Pages.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Campfire.Localization">

    <DockPanel Margin="22,20,22,18">
        <StackPanel>
            <HeaderedContentControl Header="{loc:Text Tools.Header}" Style="{StaticResource PclCard}">
                <StackPanel Margin="-8,-4,-8,-6">
                    <Button x:Name="EntryRepair" Style="{StaticResource PclEntry}" Click="EntryRepair_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Brush7}">
                                <Path Data="M8,2 L8,10 M4.8,7 L8,10.2 L11.2,7 M2.5,11 L2.5,13.5 L13.5,13.5 L13.5,11"
                                      Stroke="{DynamicResource Brush3}" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" Width="16" Height="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="14" Text="{loc:Text Tools.Repair}" />
                                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource BrushGray4}"
                                           TextTrimming="CharacterEllipsis" Text="{loc:Text Tools.RepairDescription}" />
                            </StackPanel>
                            <StackPanel x:Name="PanRepairStatus" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                        Orientation="Horizontal" Visibility="Collapsed">
                                <Ellipse x:Name="DotRepairStatus" Width="7" Height="7" VerticalAlignment="Center" />
                                <TextBlock x:Name="LabRepairStatus" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <Path Grid.Column="3" Margin="14,0,0,0" Data="M5.75,3.5 L10.25,8 L5.75,12.5" Stroke="{DynamicResource BrushGray5}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Stretch="None" Width="16" Height="16" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="EntryJre" Style="{StaticResource PclEntry}" Click="EntryJre_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Brush7}">
                                <Path Data="M2.5,5.5 L10.5,5.5 L10.5,10.5 Q10.5,13.5 6.5,13.5 Q2.5,13.5 2.5,10.5 Z M10.5,7 L12,7 Q13.5,7 13.5,9 Q13.5,11 12,11 L10.5,11 M5,2.5 L5,3.8 M8,2.5 L8,3.8"
                                      Stroke="{DynamicResource Brush3}" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" Width="16" Height="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="14" Text="{loc:Text Tools.Jre}" />
                                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource BrushGray4}"
                                           TextTrimming="CharacterEllipsis" Text="{loc:Text Tools.JreDescription}" />
                            </StackPanel>
                            <Path Grid.Column="2" Margin="14,0,0,0" Data="M5.75,3.5 L10.25,8 L5.75,12.5" Stroke="{DynamicResource BrushGray5}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Stretch="None" Width="16" Height="16" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </HeaderedContentControl>
        </StackPanel>
    </DockPanel>
</UserControl>
