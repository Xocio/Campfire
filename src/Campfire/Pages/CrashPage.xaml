<UserControl x:Class="Campfire.Pages.CrashPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Campfire.Localization">

    <UserControl.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource BrushGray4}" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,12,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Brush1}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- One file that was read: its name, when it was written, and the button that opens it. -->
        <DataTemplate x:Key="FileTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Kind, Mode=OneWay}" />
                    <Run FontSize="12" Foreground="{DynamicResource BrushGray4}" Text="{Binding Detail, Mode=OneWay}" />
                </TextBlock>
                <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" Style="{StaticResource PclTextButton}"
                        Content="{loc:Text Crash.OpenFile}" Tag="{Binding Path}" Click="BtnOpenFile_Click" />
            </Grid>
        </DataTemplate>

        <!-- One finding: a colored dot, what it is and what to do, the lines it was found in and the mods it names. -->
        <DataTemplate x:Key="FindingTemplate">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" Margin="2,7,0,0" VerticalAlignment="Top" Fill="{Binding Accent}" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock FontSize="14" TextWrapping="Wrap" Text="{Binding Title}" />
                    <TextBlock Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushGray1}" Text="{Binding Advice}" />
                    <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush3}" Text="{Binding Mods}"
                               Visibility="{Binding ModsVisibility}" />
                    <Border Margin="0,6,0,0" Padding="8,6" CornerRadius="4" Background="{DynamicResource Brush8}">
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="{DynamicResource BrushGray5}" Text="{Binding Source}" />
                            <TextBlock Margin="0,2,0,0" FontSize="11" FontFamily="{StaticResource FontCode}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushGray3}" Text="{Binding Evidence}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- The same height as the other pages. -->
    <Grid>
        <DockPanel Margin="22,20,22,18">
            <Grid DockPanel.Dock="Bottom" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LabStatus" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource BrushGray4}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnPickFile" Margin="12,0,0,0" MinWidth="110" Style="{StaticResource PclButton}"
                            Content="{loc:Text Crash.PickFile}" Click="BtnPickFile_Click" />
                    <Button x:Name="BtnCopy" Margin="12,0,0,0" MinWidth="110" Style="{StaticResource PclButton}"
                            Content="{loc:Text Crash.Copy}" Click="BtnCopy_Click" />
                    <Button x:Name="BtnAnalyze" Margin="12,0,0,0" MinWidth="120" FontWeight="Bold" Style="{StaticResource PclButtonHighlight}"
                            Content="{loc:Text Crash.Analyze}" Click="BtnAnalyze_Click" />
                </StackPanel>
            </Grid>

            <!-- The scroll area reaches past the page margin to take in the card shadows. -->
            <ScrollViewer x:Name="ScrollPage" Margin="-8" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="8">
                    <HeaderedContentControl Header="{loc:Text Crash.Version}" Style="{StaticResource PclCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbVersion" Style="{StaticResource PclComboBox}" SelectionChanged="CmbVersion_SelectionChanged" />
                                <Button x:Name="BtnRescan" Grid.Column="1" Height="32" MinWidth="76" Margin="10,0,0,0" Style="{StaticResource PclButton}"
                                        Content="{loc:Text ModCheck.Rescan}" Click="BtnRescan_Click" />
                            </Grid>
                            <ItemsControl x:Name="ListFiles" Margin="0,8,0,0" Focusable="False" ItemTemplate="{StaticResource FileTemplate}" />
                            <TextBlock x:Name="LabNoFiles" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushGray4}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl x:Name="CardResult" Margin="0,15,0,0" Header="{loc:Text Crash.Result}" Style="{StaticResource PclCard}">
                        <StackPanel>
                            <UniformGrid x:Name="GridSummary" Margin="0,0,0,12" Columns="3" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Text Crash.GameVersion}" />
                                    <TextBlock x:Name="LabGameVersion" Style="{StaticResource StatValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Text Crash.JavaVersion}" />
                                    <TextBlock x:Name="LabJavaVersion" Style="{StaticResource StatValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Text Crash.MaxMemory}" />
                                    <TextBlock x:Name="LabMaxMemory" Style="{StaticResource StatValue}" />
                                </StackPanel>
                            </UniformGrid>
                            <ContentControl x:Name="HintResult" Style="{StaticResource PclHint}">
                                <TextBlock x:Name="LabResult" TextWrapping="Wrap" />
                            </ContentControl>
                            <ItemsControl x:Name="ListFindings" Margin="0,6,0,-6" Focusable="False" ItemTemplate="{StaticResource FindingTemplate}" />
                            <TextBlock x:Name="LabStackMods" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushGray3}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <ContentControl Margin="0,15,0,0" Style="{StaticResource PclHint}">
                        <TextBlock TextWrapping="Wrap" Text="{loc:Text Crash.Note}" />
                    </ContentControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
