<UserControl x:Class="Campfire.Pages.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Campfire.Localization">

    <!-- The same height as the other pages. -->
    <Grid Height="503">
        <DockPanel Margin="22,20,22,18">
            <Grid DockPanel.Dock="Bottom" Margin="0,18,0,0">
                <Button x:Name="BtnRun" HorizontalAlignment="Right" MinWidth="140" FontWeight="Bold"
                        Style="{StaticResource PclButtonHighlight}" Content="{loc:Text Diag.Run}" Click="BtnRun_Click" />
            </Grid>

            <StackPanel>
                <HeaderedContentControl Header="{loc:Text Diag.Header}" Style="{StaticResource PclCard}">
                    <StackPanel x:Name="PanChecks" />
                </HeaderedContentControl>

                <ContentControl x:Name="HintResult" Margin="0,15,0,0" Style="{StaticResource PclHint}" Visibility="Collapsed">
                    <TextBlock x:Name="LabResult" TextWrapping="Wrap" />
                </ContentControl>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
