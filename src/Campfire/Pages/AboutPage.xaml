<UserControl x:Class="Campfire.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Campfire.Localization"
             xmlns:controls="clr-namespace:Campfire.Controls">

    <StackPanel>

        <HeaderedContentControl Header="{loc:Text About.Header}" Style="{StaticResource PclCard}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:CampfireLogo Width="64" Height="64" Margin="-4" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Campfire" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush3}" />
                            <Border Margin="10,2,0,0" Padding="6,0" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{DynamicResource Brush7}">
                                <TextBlock x:Name="LabVersion" FontSize="12" Foreground="{DynamicResource Brush3}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource BrushGray3}"
                                   Text="{loc:Text About.Summary}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="36" Height="36" Stroke="{DynamicResource Brush6}" StrokeThickness="1">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="/Assets/Avatar.jpg" Stretch="UniformToFill"
                                        RenderOptions.BitmapScalingMode="HighQuality" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Xocio" />
                        <TextBlock Margin="0,1,0,0" FontSize="12" Foreground="{DynamicResource BrushGray4}"
                                   Text="{loc:Text About.AuthorRole}" />
                    </StackPanel>
                    <Button Grid.Column="2" MinWidth="88" Height="30" Content="{loc:Text About.Homepage}"
                            Style="{StaticResource PclButton}" Tag="https://github.com/Xocio"
                            Click="LinkButton_Click" />
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Brush7}">
                        <Path Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource Brush3}"
                              Data="M8,0 C3.58,0 0,3.58 0,8 C0,11.54 2.29,14.53 5.47,15.59 C5.87,15.66 6.02,15.42 6.02,15.21 C6.02,15.02 6.01,14.39 6.01,13.72 C4,14.09 3.48,13.23 3.32,12.78 C3.23,12.55 2.84,11.84 2.5,11.65 C2.22,11.5 1.82,11.13 2.49,11.12 C3.12,11.11 3.57,11.7 3.72,11.94 C4.44,13.15 5.59,12.81 6.05,12.6 C6.12,12.08 6.33,11.73 6.56,11.53 C4.78,11.33 2.92,10.64 2.92,7.58 C2.92,6.71 3.23,5.99 3.74,5.43 C3.66,5.23 3.38,4.41 3.82,3.31 C3.82,3.31 4.49,3.1 6.02,4.13 C6.66,3.95 7.34,3.86 8.02,3.86 C8.7,3.86 9.38,3.95 10.02,4.13 C11.55,3.09 12.22,3.31 12.22,3.31 C12.66,4.41 12.38,5.23 12.3,5.43 C12.81,5.99 13.12,6.7 13.12,7.58 C13.12,10.65 11.25,11.33 9.47,11.53 C9.76,11.78 10.01,12.26 10.01,13.01 C10.01,14.08 10,14.94 10,15.21 C10,15.42 10.15,15.67 10.55,15.59 C13.71,14.53 16,11.53 16,8 C16,3.58 12.42,0 8,0 Z" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Xocio/Campfire" />
                        <TextBlock Margin="0,1,0,0" FontSize="12" Foreground="{DynamicResource BrushGray4}"
                                   Text="{loc:Text About.RepoSummary}" />
                    </StackPanel>
                    <Button Grid.Column="2" MinWidth="88" Height="30" Content="{loc:Text About.Repository}"
                            Style="{StaticResource PclButtonHighlight}" Tag="https://github.com/Xocio/Campfire"
                            Click="LinkButton_Click" />
                </Grid>
            </StackPanel>
        </HeaderedContentControl>

        <HeaderedContentControl Margin="0,15,0,0" Header="{loc:Text About.Tour}" Style="{StaticResource PclCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource BrushGray3}"
                           Text="{loc:Text About.TourSummary}" />
                <Button Grid.Column="1" Margin="12,0,0,0" MinWidth="88" Height="30" Content="{loc:Text About.TourButton}"
                        Style="{StaticResource PclButton}" Click="BtnTour_Click" />
            </Grid>
        </HeaderedContentControl>

        <HeaderedContentControl Margin="0,15,0,0" Header="{loc:Text About.Notes}" Style="{StaticResource PclCard}">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushGray3}" Text="{loc:Text About.Note}" />
        </HeaderedContentControl>

    </StackPanel>
</UserControl>
