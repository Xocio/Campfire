<UserControl x:Class="Campfire.Pages.MapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Campfire.Localization">

    <UserControl.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Height="503">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================== Map ======================== -->
        <HeaderedContentControl Margin="22,20,22,0" Header="{loc:Text Map.Header}" Style="{StaticResource PclCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="PanLogo" Width="56" Height="56" CornerRadius="5" Background="{DynamicResource Brush7}" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="LabName" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="LabSummary" Margin="0,3,0,0" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource BrushGray3}" />
                    <TextBlock x:Name="LabMeta" Margin="0,3,0,0" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource BrushGray4}" />
                </StackPanel>
                <Button x:Name="BtnWebsite" Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                        Style="{StaticResource PclTextButton}" Content="{loc:Text Map.Website}" Click="BtnWebsite_Click" />
            </Grid>
        </HeaderedContentControl>

        <ScrollViewer x:Name="ScrollDetail" Grid.Row="1" Margin="12,11,6,0" VerticalScrollBarVisibility="Visible" Focusable="False">
            <StackPanel Margin="10,4,10,8">

                <!-- ======================== Files ======================== -->
                <HeaderedContentControl Header="{loc:Text Map.Files}" Style="{StaticResource PclCard}">
                    <StackPanel>
                        <StackPanel x:Name="ListFiles" />
                        <StackPanel x:Name="PanState" HorizontalAlignment="Center" Orientation="Horizontal">
                            <Control x:Name="SpinState" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource PclSpinner}" />
                            <TextBlock x:Name="LabState" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"
                                       Foreground="{DynamicResource BrushGray3}" />
                            <Button x:Name="BtnRetry" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource PclTextButton}"
                                    Content="{loc:Text Maps.Retry}" Visibility="Collapsed" Click="BtnRetry_Click" />
                        </StackPanel>
                        <ContentControl x:Name="HintWebsite" Margin="0,14,0,0" Style="{StaticResource PclHintOrange}" Visibility="Collapsed">
                            <TextBlock TextWrapping="Wrap" Text="{loc:Text Map.WebsiteOnly}" />
                        </ContentControl>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- ======================== About ======================== -->
                <HeaderedContentControl x:Name="CardAbout" Margin="0,15,0,0" Header="{loc:Text Map.About}" Style="{StaticResource PclCard}"
                                        Visibility="Collapsed">
                    <StackPanel>
                        <WrapPanel x:Name="PanScreenshots" Margin="0,0,-8,4" />
                        <TextBlock x:Name="LabDescription" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource BrushGray1}" />
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="22,12,22,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="BarDownload" Margin="0,0,20,0" VerticalAlignment="Center" Style="{StaticResource PclProgressBar}"
                         Visibility="Hidden" />
            <Button x:Name="BtnCancel" Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource PclTextButton}"
                    Content="{loc:Text Map.Cancel}" Visibility="Collapsed" Click="BtnCancel_Click" />
            <Button x:Name="BtnDownload" Grid.Column="2" MinWidth="140" FontWeight="Bold" Content="{loc:Text Map.Download}"
                    Style="{StaticResource PclButtonHighlight}" IsEnabled="False" Click="BtnDownload_Click" />
        </Grid>
    </Grid>
</UserControl>
