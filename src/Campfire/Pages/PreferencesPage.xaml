<UserControl x:Class="Campfire.Pages.PreferencesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Campfire.Localization"
             xmlns:pages="clr-namespace:Campfire.Pages">

    <UserControl.Resources>
        <!-- Rows inside a card: the name on the left, the control on the right, all names in one column. -->
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush1}" />
        </Style>
        <Style x:Key="RowNote" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource BrushGray4}" />
        </Style>
        <Style x:Key="NavIcon" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
        </Style>
        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionScroll" TargetType="ScrollViewer">
            <Setter Property="Margin" Value="4,12,12,10" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid Height="503">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="132" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ======================== Navigation ======================== -->
        <Border Background="{DynamicResource BrushCard}" CornerRadius="0,0,0,6" />
        <StackPanel x:Name="PanNav" Margin="0,12,0,0">
            <RadioButton x:Name="NavPersonalize" GroupName="Nav" IsChecked="True" Style="{StaticResource PclNavItem}"
                         Checked="Nav_Checked">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}"
                          Data="M5.6,2.5 L2.9,3.7 L1.5,7.2 L3.6,8.1 L4.5,6.8 L4.5,13.5 L11.5,13.5 L11.5,6.8 L12.4,8.1 L14.5,7.2 L13.1,3.7 L10.4,2.5 C9.9,3.8 9.1,4.5 8,4.5 C6.9,4.5 6.1,3.8 5.6,2.5 Z" />
                    <TextBlock Style="{StaticResource NavText}" Text="{loc:Text Prefs.NavPersonalize}" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavGeneral" GroupName="Nav" Style="{StaticResource PclNavItem}" Checked="Nav_Checked">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}"
                          Data="M2.5,4.5 L13.5,4.5 M2.5,11.5 L13.5,11.5 M5.5,2.5 L5.5,6.5 M10.5,9.5 L10.5,13.5" />
                    <TextBlock Style="{StaticResource NavText}" Text="{loc:Text Prefs.NavGeneral}" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavAbout" GroupName="Nav" Style="{StaticResource PclNavItem}" Checked="Nav_Checked">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}"
                          Data="M14.5,8 A6.5,6.5 0 1 1 1.5,8 A6.5,6.5 0 1 1 14.5,8 Z M8,7.3 L8,11.5 M8,4.6 L8,4.7" />
                    <TextBlock Style="{StaticResource NavText}" Text="{loc:Text Prefs.NavAbout}" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavLicenses" GroupName="Nav" Style="{StaticResource PclNavItem}" Checked="Nav_Checked">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}"
                          Data="M3.5,1.5 L9.5,1.5 L12.5,4.5 L12.5,14.5 L3.5,14.5 Z M9.5,1.5 L9.5,4.5 L12.5,4.5 M6,8 L10,8 M6,11 L10,11" />
                    <TextBlock Style="{StaticResource NavText}" Text="{loc:Text Prefs.NavLicenses}" />
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <Grid Grid.Column="1">

            <!-- ======================== Personalize ======================== -->
            <ScrollViewer x:Name="PanPersonalize" Style="{StaticResource SectionScroll}">
                <StackPanel Margin="10,8,10,8" Grid.IsSharedSizeScope="True">
                    <HeaderedContentControl Header="{loc:Text Prefs.Theme}" Style="{StaticResource PclCard}">
                        <Grid Margin="10,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource RowLabel}" Margin="0,0,24,0" Text="{loc:Text Prefs.ThemeMode}" />
                            <ComboBox x:Name="CmbMode" Grid.Column="1" Style="{StaticResource PclComboBox}"
                                      SelectionChanged="CmbMode_SelectionChanged" />

                            <TextBlock Grid.Row="1" Margin="0,12,24,0" VerticalAlignment="Top" Padding="0,6,0,0"
                                       Foreground="{DynamicResource Brush1}" Text="{loc:Text Prefs.Style}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                                <ComboBox x:Name="CmbStyle" Style="{StaticResource PclComboBox}"
                                          SelectionChanged="CmbStyle_SelectionChanged" />
                                <TextBlock x:Name="LabStyleNote" Style="{StaticResource RowNote}" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Margin="0,12,24,0" VerticalAlignment="Top" Padding="0,6,0,0"
                                       Foreground="{DynamicResource Brush1}" Text="{loc:Text Prefs.ColorSource}" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
                                <ComboBox x:Name="CmbSource" Style="{StaticResource PclComboBox}"
                                          SelectionChanged="CmbSource_SelectionChanged" />
                                <TextBlock x:Name="LabSourceNote" Style="{StaticResource RowNote}" />
                            </StackPanel>

                            <!-- Fixed colors, or the colors found in the wallpaper. -->
                            <TextBlock Grid.Row="3" Margin="0,14,24,0" VerticalAlignment="Top" Padding="0,8,0,0"
                                       Foreground="{DynamicResource Brush1}" Text="{loc:Text Prefs.ThemeColor}" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,14,0,0">
                                <WrapPanel x:Name="PanSwatches" Margin="-4,0,0,0" />
                                <WrapPanel x:Name="PanWallpaperSwatches" Margin="-4,0,0,0" />
                                <TextBlock x:Name="LabNoWallpaperColor" Style="{StaticResource RowNote}" Margin="0,0,0,6"
                                           Text="{loc:Text Prefs.NoWallpaperColor}" Visibility="Collapsed" />
                                <Grid x:Name="PanCustomColor" Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtCustomColor" Width="112" MaxLength="7" FontFamily="{StaticResource FontCode}"
                                             Style="{StaticResource PclTextBox}" Tag="#RRGGBB"
                                             KeyDown="TxtCustomColor_KeyDown" LostKeyboardFocus="TxtCustomColor_LostFocus" />
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource BrushGray4}" Text="{loc:Text Prefs.CustomColorHint}" />
                                </Grid>
                                <Button x:Name="BtnRefreshWallpaper" HorizontalAlignment="Left" Margin="0,0,0,2"
                                        Style="{StaticResource PclTextButton}" Content="{loc:Text Prefs.RefreshWallpaper}"
                                        Click="BtnRefreshWallpaper_Click" />
                            </StackPanel>
                        </Grid>
                    </HeaderedContentControl>

                    <HeaderedContentControl Margin="0,15,0,0" Header="{loc:Text Prefs.Motion}" Style="{StaticResource PclCard}">
                        <StackPanel Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ChkMotion" Style="{StaticResource PclCheckBox}" Content="{loc:Text Prefs.MotionEnabled}"
                                          Click="ChkMotion_Click" />
                                <ContentControl Style="{StaticResource PclHelp}" ToolTip="{loc:Text Prefs.MotionNote}" />
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ======================== General ======================== -->
            <ScrollViewer x:Name="PanGeneral" Style="{StaticResource SectionScroll}" Visibility="Hidden">
                <StackPanel Margin="10,8,10,8">
                    <HeaderedContentControl Header="{loc:Text Prefs.General}" Style="{StaticResource PclCard}">
                        <Grid Margin="10,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Margin="0,0,24,0" Text="{loc:Text Prefs.Language}" />
                            <ComboBox x:Name="CmbLanguage" Grid.Column="1" Style="{StaticResource PclComboBox}"
                                      SelectionChanged="CmbLanguage_SelectionChanged">
                                <ComboBoxItem Content="简体中文" />
                                <ComboBoxItem Content="English" />
                            </ComboBox>
                        </Grid>
                    </HeaderedContentControl>

                    <HeaderedContentControl Margin="0,15,0,0" Header="{loc:Text Prefs.TrayHeader}" Style="{StaticResource PclCard}">
                        <StackPanel Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ChkTray" Style="{StaticResource PclCheckBox}" Content="{loc:Text Prefs.Tray}"
                                          Click="ChkTray_Click" />
                                <ContentControl Style="{StaticResource PclHelp}" ToolTip="{loc:Text Prefs.TrayNote}" />
                            </StackPanel>

                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <CheckBox x:Name="ChkCloseToTray" Style="{StaticResource PclCheckBox}"
                                          Content="{loc:Text Prefs.CloseToTray}" Click="ChkCloseToTray_Click" />
                                <ContentControl Style="{StaticResource PclHelp}" ToolTip="{loc:Text Prefs.CloseToTrayNote}" />
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- Only official builds know the update service; the cards stay hidden in builds made from source. -->
                    <HeaderedContentControl x:Name="CardUpdate" Margin="0,15,0,0" Header="{loc:Text Prefs.UpdateHeader}"
                                            Style="{StaticResource PclCard}">
                        <StackPanel Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ChkAutoCheck" Style="{StaticResource PclCheckBox}" Content="{loc:Text Prefs.AutoCheck}"
                                          Click="ChkAutoCheck_Click" />
                                <ContentControl Style="{StaticResource PclHelp}" ToolTip="{loc:Text Prefs.AutoCheckNote}" />
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <Button x:Name="BtnCheckUpdate" MinWidth="88" Height="30" Style="{StaticResource PclButton}"
                                        Content="{loc:Text Prefs.CheckNow}" Click="BtnCheckUpdate_Click" />
                                <TextBlock x:Name="LabUpdateStatus" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource BrushGray4}" />
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl x:Name="CardPrivacy" Margin="0,15,0,0" Header="{loc:Text Prefs.PrivacyHeader}"
                                            Style="{StaticResource PclCard}">
                        <StackPanel Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ChkStats" Style="{StaticResource PclCheckBox}" Content="{loc:Text Prefs.Stats}"
                                          Click="ChkStats_Click" />
                                <ContentControl Style="{StaticResource PclHelp}" ToolTip="{loc:Text Prefs.StatsNote}" />
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <Button Style="{StaticResource PclTextButton}" Content="{loc:Text Prefs.StatsPreview}"
                                        Click="BtnStatsPreview_Click" />
                                <Button Margin="20,0,0,0" Style="{StaticResource PclTextButton}" Content="{loc:Text Prefs.StatsReset}"
                                        Click="BtnStatsReset_Click" />
                                <Button x:Name="BtnPrivacy" Margin="20,0,0,0" Style="{StaticResource PclTextButton}"
                                        Content="{loc:Text Prefs.PrivacyPolicy}" Click="BtnPrivacy_Click" />
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ======================== About ======================== -->
            <ScrollViewer x:Name="PanAbout" Style="{StaticResource SectionScroll}" Visibility="Hidden">
                <pages:AboutPage Margin="10,8,10,8" />
            </ScrollViewer>

            <!-- ======================== Open source licenses ======================== -->
            <ScrollViewer x:Name="PanLicenses" Style="{StaticResource SectionScroll}" Visibility="Hidden">
                <StackPanel Margin="10,8,10,8">
                    <HeaderedContentControl Header="{loc:Text Licenses.Header}" Style="{StaticResource PclCard}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,4" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushGray3}"
                                       Text="{loc:Text Licenses.Intro}" />
                            <ItemsControl x:Name="ListLicenses" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                                                    <Border Margin="8,0,0,0" Padding="6,0" CornerRadius="3" VerticalAlignment="Center"
                                                            Background="{DynamicResource Brush7}">
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource Brush3}" Text="{Binding License}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource BrushGray4}" Text="{Binding Description}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                                    Style="{StaticResource PclTextButton}" Content="{Binding LinkText}"
                                                    Tag="{Binding Url}" Click="LinkButton_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Margin="0,15,0,0" Header="{loc:Text Licenses.Assets}" Style="{StaticResource PclCard}">
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushGray3}"
                                   Text="{loc:Text Licenses.AssetsNote}" />
                    </HeaderedContentControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
