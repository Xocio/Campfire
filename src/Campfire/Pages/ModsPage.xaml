<UserControl x:Class="Campfire.Pages.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Campfire.Localization">

    <!-- The same height as the other pages, so the window does not change size. -->
    <Grid Height="503">
        <DockPanel Margin="22,20,22,18">
            <Grid DockPanel.Dock="Bottom" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="PanSource" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" Text="{loc:Text Mods.Source}" />
                    <ComboBox x:Name="CmbSource" Width="150" Margin="12,0,0,0" Style="{StaticResource PclComboBox}"
                              SelectionChanged="CmbSource_SelectionChanged" />
                    <ContentControl Style="{StaticResource PclHelp}" ToolTip="{loc:Text Mods.SourceNote}" />
                </StackPanel>
                <StackPanel x:Name="PanProgress" Margin="0,0,20,0" VerticalAlignment="Center" Visibility="Hidden">
                    <TextBlock x:Name="LabProgress" FontSize="12" Foreground="{DynamicResource BrushGray4}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="BarSync" Margin="0,6,0,0" Style="{StaticResource PclProgressBar}" />
                </StackPanel>
                <Button x:Name="BtnSync" Grid.Column="1" MinWidth="140" FontWeight="Bold" Content="{loc:Text Mods.Sync}"
                        Style="{StaticResource PclButtonHighlight}" IsEnabled="False" Click="BtnSync_Click" />
            </Grid>

            <StackPanel>
                <!-- ======================== Versions ======================== -->
                <HeaderedContentControl Header="{loc:Text Mods.Versions}" Style="{StaticResource PclCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock VerticalAlignment="Center" Text="{loc:Text Mods.HostLabel}" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" Orientation="Horizontal">
                            <TextBlock x:Name="LabHostGame" VerticalAlignment="Center" Foreground="{DynamicResource Brush1}" />
                            <TextBlock x:Name="LabHostCount" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource BrushGray4}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center" Text="{loc:Text Mods.LocalLabel}" />
                        <Grid Grid.Row="1" Grid.Column="1" Margin="14,10,0,0">
                            <ComboBox x:Name="CmbVersion" Style="{StaticResource PclComboBox}" SelectionChanged="CmbVersion_SelectionChanged" />
                            <TextBlock x:Name="LabVersions" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushGray3}" Visibility="Collapsed" />
                        </Grid>

                        <Grid Grid.Row="2" Grid.Column="1" Margin="14,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LabTargetPath" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource BrushGray4}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal">
                                <Button x:Name="BtnAddFolder" FontSize="12" Style="{StaticResource PclTextButton}"
                                        Content="{loc:Text Mods.AddFolder}" Click="BtnAddFolder_Click" />
                                <Button x:Name="BtnOpenFolder" Margin="14,0,0,0" FontSize="12" Style="{StaticResource PclTextButton}"
                                        Content="{loc:Text Mods.OpenFolder}" Click="BtnOpenFolder_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </HeaderedContentControl>

                <!-- ======================== Differences ======================== -->
                <HeaderedContentControl x:Name="CardChanges" Margin="0,15,0,0" Style="{StaticResource PclCard}">
                    <StackPanel>
                        <ScrollViewer x:Name="ScrollChanges" MaxHeight="140" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel x:Name="ListChanges" Margin="0,0,6,0" />
                        </ScrollViewer>
                        <TextBlock x:Name="LabChanges" TextWrapping="Wrap" Foreground="{DynamicResource BrushGray3}" />
                        <TextBlock x:Name="LabIgnored" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrushGray4}" Visibility="Collapsed" />
                        <StackPanel x:Name="PanRemoveExtra" Margin="0,10,0,0" Orientation="Horizontal" Visibility="Collapsed">
                            <CheckBox x:Name="ChkRemoveExtra" Style="{StaticResource PclCheckBox}"
                                      Content="{loc:Text Mods.RemoveExtra}" Click="ChkRemoveExtra_Click" />
                            <ContentControl Style="{StaticResource PclHelp}" ToolTip="{loc:Text Mods.RemoveExtraNote}" />
                        </StackPanel>
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
