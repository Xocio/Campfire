<UserControl x:Class="Campfire.Pages.BackupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Campfire.Localization">

    <UserControl.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource BrushGray4}" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,12,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Brush1}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- One backup: clock icon, time with the age and size below, and the button that shows the file. -->
        <DataTemplate x:Key="BackupTemplate">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Brush7}" VerticalAlignment="Center">
                    <Path Data="M8,2.5 A5.5,5.5 0 1 1 7.99,2.5 Z M8,5 L8,8.2 L10.2,9.6" Stroke="{DynamicResource Brush3}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stretch="None" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="14" Text="{Binding Title}" />
                        <Border Margin="8,0,0,0" Padding="5,0" CornerRadius="3" VerticalAlignment="Center"
                                Background="{DynamicResource Brush7}" Visibility="{Binding CurrentVisibility}">
                            <TextBlock FontSize="11" Foreground="{DynamicResource Brush3}" Text="{loc:Text Backup.Current}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource BrushGray4}"
                               TextTrimming="CharacterEllipsis" Text="{Binding Detail}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button MinWidth="76" Style="{StaticResource PclButton}" Content="{loc:Text Backup.Restore}"
                            Tag="{Binding Entry}" Click="BtnRestore_Click" />
                    <Button Margin="10,0,0,0" MinWidth="76" Style="{StaticResource PclButton}" Content="{loc:Text Backup.Reveal}"
                            Tag="{Binding Path}" Click="BtnReveal_Click" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- The same height as the other pages. -->
    <Grid>
        <DockPanel Margin="22,20,22,18">
            <Grid DockPanel.Dock="Bottom" Margin="0,18,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button MinWidth="140" Style="{StaticResource PclButton}" Content="{loc:Text Settings.OpenBackups}"
                            Click="BtnOpenFolder_Click" />
                    <Button x:Name="BtnBackupNow" Margin="12,0,0,0" MinWidth="140" FontWeight="Bold"
                            Style="{StaticResource PclButtonHighlight}" Content="{loc:Text Backup.Now}" Click="BtnBackupNow_Click" />
                </StackPanel>
            </Grid>

            <StackPanel>
                <!-- ======================== The world ======================== -->
                <HeaderedContentControl x:Name="CardWorld" Style="{StaticResource PclCard}">
                    <StackPanel>
                        <UniformGrid Columns="3">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Text Backup.Version}" />
                                <TextBlock x:Name="LabVersion" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Text Backup.Mode}" />
                                <TextBlock x:Name="LabMode" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Text Backup.Kept}" />
                                <TextBlock x:Name="LabKept" Style="{StaticResource StatValue}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock x:Name="LabNote" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrushGray4}" />
                    </StackPanel>
                </HeaderedContentControl>

                <!-- ======================== Backups ======================== -->
                <HeaderedContentControl Margin="0,15,0,0" Header="{loc:Text Backup.List}" Style="{StaticResource PclCard}">
                    <Grid>
                        <ScrollViewer MaxHeight="184" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl x:Name="ListBackups" Margin="0,-5" Focusable="False" ItemTemplate="{StaticResource BackupTemplate}" />
                        </ScrollViewer>
                        <TextBlock x:Name="LabEmpty" Foreground="{DynamicResource BrushGray4}" Text="{loc:Text Backup.Empty}"
                                   Visibility="Collapsed" />
                    </Grid>
                </HeaderedContentControl>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
