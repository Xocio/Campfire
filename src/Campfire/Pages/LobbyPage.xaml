<UserControl x:Class="Campfire.Pages.LobbyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Campfire.Localization">

    <UserControl.Resources>
        <!-- The list always keeps room for its scroll bar. -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Height="503">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================== Filters ======================== -->
        <Grid Margin="22,20,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtSearch" Height="30" Style="{StaticResource PclTextBox}" Tag="{loc:Text Lobby.SearchHint}"
                     MaxLength="40" TextChanged="TxtSearch_TextChanged" />
            <ComboBox x:Name="CmbVersion" Grid.Column="1" Margin="8,0,0,0" MaxDropDownHeight="300"
                      Style="{StaticResource PclComboBox}" SelectionChanged="CmbVersion_SelectionChanged" />
            <Button x:Name="BtnRefresh" Grid.Column="2" Margin="8,0,0,0" Height="30" MinWidth="88"
                    Style="{StaticResource PclButton}" Content="{loc:Text Lobby.Refresh}" Click="BtnRefresh_Click" />
            <!-- Nothing to join? Open a room of your own. -->
            <Button x:Name="BtnCreate" Grid.Column="3" Margin="8,0,0,0" Height="30" MinWidth="104" FontWeight="Bold"
                    Style="{StaticResource PclButtonHighlight}" Content="{loc:Text Link.Create}" Click="BtnCreate_Click" />
        </Grid>

        <!-- A message from the author about the lobby. -->
        <ContentControl x:Name="HintNotice" Grid.Row="1" Margin="22,12,22,0" Style="{StaticResource PclHint}" Visibility="Collapsed">
            <TextBlock x:Name="LabNotice" TextWrapping="Wrap" />
        </ContentControl>

        <!-- ======================== Rooms ======================== -->
        <ScrollViewer x:Name="ScrollRooms" Grid.Row="2" Margin="12,8,6,10" VerticalScrollBarVisibility="Visible" Focusable="False">
            <StackPanel Margin="10,4,10,8">
                <HeaderedContentControl x:Name="CardRooms" Header="{loc:Text Lobby.Header}" Style="{StaticResource PclCard}">
                    <StackPanel>
                        <StackPanel x:Name="ListRooms" Margin="-8,-4,-8,0" />
                        <!-- Loading, empty and error states. -->
                        <StackPanel x:Name="PanState" Margin="0,4,0,2" HorizontalAlignment="Center" Orientation="Horizontal">
                            <Control x:Name="SpinState" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource PclSpinner}" />
                            <TextBlock x:Name="LabState" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"
                                       Foreground="{DynamicResource BrushGray3}" />
                            <Button x:Name="BtnRetry" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource PclTextButton}"
                                    Content="{loc:Text Lobby.Retry}" Visibility="Collapsed" Click="BtnRefresh_Click" />
                        </StackPanel>
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
