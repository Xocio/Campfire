<UserControl x:Class="Campfire.Pages.LinkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Campfire.Localization">

    <UserControl.Resources>
        <!-- One step of creating or joining a room: gray dot, spinner or green check, then the title. -->
        <DataTemplate x:Key="StepTemplate">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="16" Height="16" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource BrushGray7}" />
                    <Control x:Name="Spinner" Style="{StaticResource PclSpinner}" Visibility="Collapsed" />
                    <Border x:Name="Check" CornerRadius="8" Background="{DynamicResource BrushGreen}" Visibility="Collapsed"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform />
                        </Border.RenderTransform>
                        <Path Data="M4.6,8.2 L7,10.4 L11.4,5.8" Stroke="{DynamicResource BrushOnAccent}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stretch="None" Width="16" Height="16" />
                    </Border>
                </Grid>
                <TextBlock x:Name="LabTitle" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushGray4}" Text="{Binding Title}" />
                <TextBlock x:Name="LabDetail" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource BrushGray4}" Text="{Binding Detail}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Active">
                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                    <Setter TargetName="LabTitle" Property="Foreground" Value="{DynamicResource Brush3}" />
                    <Setter TargetName="LabDetail" Property="Foreground" Value="{DynamicResource Brush3}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                 From="0.3" To="1" Duration="0:0:0.4" EasingFunction="{StaticResource EaseSpring}" />
                                <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                 From="0.3" To="1" Duration="0:0:0.4" EasingFunction="{StaticResource EaseSpring}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                    <Setter TargetName="LabTitle" Property="Foreground" Value="{DynamicResource Brush1}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            A player in the room: skin face (or initial), name, role tag and the program they use.
            On the host's list, pointing at a guest shows the actions to remove or block them.
        -->
        <DataTemplate x:Key="PlayerTemplate">
            <Grid x:Name="Row" Margin="0,3,6,3" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="PanActions" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                            Orientation="Horizontal" Opacity="0" Visibility="{Binding ManageVisibility}">
                    <Button Margin="0,0,14,0" Style="{StaticResource PclTextButton}" Content="{loc:Text Link.Allow}" Tag="{Binding}"
                            Visibility="{Binding AllowVisibility}" Click="BtnAllowPlayer_Click" />
                    <Button Style="{StaticResource PclTextButton}" Content="{loc:Text Link.Remove}" Tag="{Binding}"
                            Click="BtnRemovePlayer_Click" />
                    <Button Margin="14,0,0,0" Style="{StaticResource PclDangerTextButton}" Content="{loc:Text Link.Block}"
                            Tag="{Binding}" Click="BtnBlockPlayer_Click" />
                </StackPanel>
                <Grid Width="30" Height="30">
                    <Border CornerRadius="4" Background="{DynamicResource Brush7}">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush3}" Text="{Binding Initial}" />
                    </Border>
                    <Image Source="{Binding Head}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                        <Border Margin="8,0,0,0" Padding="5,0" CornerRadius="3" VerticalAlignment="Center" Visibility="{Binding TagVisibility}"
                                Background="{Binding TagBackground}">
                            <TextBlock FontSize="11" Foreground="{Binding TagForeground}" Text="{Binding Tag}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="11" Foreground="{DynamicResource BrushGray5}" Text="{Binding Vendor}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="200" />
                        <TextBlock Margin="8,0,0,0" FontSize="11" Foreground="{Binding ConnectionForeground}" Text="{Binding Connection}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PanActions" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PanActions" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.25" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Small caption above a value in the statistics rows. -->
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource BrushGray4}" />
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Brush1}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- The cards of an open room. The height is set to the page height above the button bar; the value here is the least it can be. -->
        <Style x:Key="RoomScroll" TargetType="ScrollViewer">
            <Setter Property="Margin" Value="-8,-8,-8,-8" />
            <Setter Property="MaxHeight" Value="431" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <!-- One row of the room tools: round icon, name with its state below, and the action on the right. -->
        <Style x:Key="ToolRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,5" />
        </Style>
        <Style x:Key="ToolIcon" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{DynamicResource Brush7}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToolGlyph" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource Brush3}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToolText" TargetType="StackPanel">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToolState" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource BrushGray4}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource PclButton}">
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToolButtonHighlight" TargetType="Button" BasedOn="{StaticResource PclButtonHighlight}">
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>

    <!-- All states share one cell; inactive ones are Hidden. -->
    <Grid Margin="22,20,22,18">

        <!-- ======================== Enter a code ======================== -->
        <DockPanel x:Name="PanJoin">
            <Grid DockPanel.Dock="Bottom" Margin="0,18,0,0">
                <Button x:Name="BtnGoLobby" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource PclTextButton}"
                        Content="{loc:Text Lobby.GoToLobby}" Click="BtnGoLobby_Click" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Content="{loc:Text Link.Back}" Style="{StaticResource PclButton}" Click="BtnBack_Click" />
                    <Button x:Name="BtnJoinConfirm" Margin="12,0,0,0" MinWidth="140" FontWeight="Bold"
                            Content="{loc:Text Link.JoinConfirm}" Style="{StaticResource PclButtonHighlight}"
                            IsEnabled="False" Click="BtnJoinConfirm_Click" />
                </StackPanel>
            </Grid>
            <StackPanel>
                <HeaderedContentControl Header="{loc:Text Link.JoinHeader}" Style="{StaticResource PclCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:Text Link.JoinPrompt}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtCode" Height="38" FontSize="16" FontFamily="{StaticResource FontCode}"
                                     Style="{StaticResource PclTextBox}" Tag="U/XXXX-XXXX-XXXX-XXXX"
                                     TextChanged="TxtCode_TextChanged" KeyDown="TxtCode_KeyDown" />
                            <Button Grid.Column="1" Height="38" MinWidth="88" Margin="10,0,0,0"
                                    Content="{loc:Text Link.Paste}" Style="{StaticResource PclButton}" Click="BtnPaste_Click" />
                        </Grid>
                        <TextBlock x:Name="LabCodeState" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrushGray4}" Text="{loc:Text Link.CodeHint}" />
                    </StackPanel>
                </HeaderedContentControl>

                <ContentControl Margin="0,15,0,0" Style="{StaticResource PclHint}">
                    <TextBlock TextWrapping="Wrap" Text="{loc:Text Link.JoinTip}" />
                </ContentControl>
            </StackPanel>
        </DockPanel>

        <!-- ======================== In progress ======================== -->
        <DockPanel x:Name="PanWorking" Visibility="Hidden">
            <Grid DockPanel.Dock="Bottom" Margin="0,18,0,0">
                <Button x:Name="BtnCancelWork" HorizontalAlignment="Right" Content="{loc:Text Link.Cancel}" Style="{StaticResource PclButton}"
                        Click="BtnStop_Click" />
            </Grid>
            <StackPanel>
                <HeaderedContentControl x:Name="CardWorking" Style="{StaticResource PclCard}">
                    <StackPanel>
                        <ItemsControl x:Name="ListSteps" Focusable="False" ItemTemplate="{StaticResource StepTemplate}" />
                        <ProgressBar x:Name="BarDownload" Margin="26,4,0,4" Style="{StaticResource PclProgressBar}"
                                     Visibility="Collapsed" />
                    </StackPanel>
                </HeaderedContentControl>

                <ContentControl x:Name="HintWorld" Margin="0,15,0,0" Style="{StaticResource PclHint}" Visibility="Collapsed">
                    <StackPanel>
                        <!-- What Campfire does by itself; the manual steps below always work as well. -->
                        <TextBlock x:Name="LabAutoLan" Margin="0,0,0,6" TextWrapping="Wrap" FontWeight="Bold" Visibility="Collapsed" />
                        <TextBlock TextWrapping="Wrap" Text="{loc:Text Link.WorldGuide}" />
                        <Button x:Name="BtnManualPort" Margin="0,8,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource PclTextButton}" Content="{loc:Text Link.ManualPort}"
                                Click="BtnManualPort_Click" />
                        <StackPanel x:Name="PanPortInput" Margin="0,8,0,0" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBox x:Name="TxtPort" Width="120" MaxLength="5" Style="{StaticResource PclTextBox}"
                                     Tag="25565" KeyDown="TxtPort_KeyDown" />
                            <Button Margin="10,0,0,0" Height="32" MinWidth="88" Content="{loc:Text Link.UsePort}"
                                    Style="{StaticResource PclButton}" Click="BtnUsePort_Click" />
                        </StackPanel>
                    </StackPanel>
                </ContentControl>

                <ContentControl x:Name="HintSearch" Margin="0,15,0,0" Style="{StaticResource PclHint}" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" Text="{loc:Text Link.SearchSlow}" />
                </ContentControl>
            </StackPanel>
        </DockPanel>

        <!-- ======================== Room open (host) ======================== -->
        <DockPanel x:Name="PanHost" Visibility="Hidden">
            <Grid DockPanel.Dock="Bottom" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Whether the room is listed in the public lobby. -->
                <Grid x:Name="PanLobbyState" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="DotLobby" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="LabLobby" Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource BrushGray4}" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnFavoriteHost" Margin="12,0,0,0" MinWidth="92" Style="{StaticResource PclButton}"
                            Click="BtnFavorite_Click" />
                    <Button x:Name="BtnLobby" Margin="12,0,0,0" MinWidth="140" Click="BtnLobby_Click" />
                    <Button x:Name="BtnCloseRoom" Margin="12,0,0,0" Content="{loc:Text Link.CloseRoom}"
                            Style="{StaticResource PclButton}" Click="BtnStop_Click" />
                </StackPanel>
            </Grid>
            <!-- The scroll area reaches past the page margin to take in the card shadows. -->
            <ScrollViewer x:Name="ScrollHost" Style="{StaticResource RoomScroll}">
            <StackPanel Margin="8,8,8,8">
                <HeaderedContentControl Header="{loc:Text Link.HostReady}" Style="{StaticResource PclCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Text Link.InviteCode}" />
                                <TextBlock x:Name="LabCode" Margin="0,2,0,0" FontFamily="{StaticResource FontCode}" FontSize="24"
                                           FontWeight="Bold" Foreground="{DynamicResource Brush3}" />
                            </StackPanel>
                            <Button x:Name="BtnCopyCode" Grid.Column="1" MinWidth="128" VerticalAlignment="Center"
                                    FontWeight="Bold" Style="{StaticResource PclButtonHighlight}"
                                    Click="BtnCopyCode_Click" />
                        </Grid>
                        <TextBlock x:Name="LabHostTip" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrushGray4}" />
                        <UniformGrid Margin="0,14,0,0" Columns="3">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Text Link.GamePort}" />
                                <TextBlock x:Name="LabHostPort" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Text Link.Connections}" />
                                <TextBlock x:Name="LabHostLinks" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Text Link.LocalNetwork}" />
                                <TextBlock x:Name="LabHostNat" Style="{StaticResource StatValue}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </HeaderedContentControl>

                <ContentControl x:Name="HintHostNodes" Margin="0,15,0,0" Style="{StaticResource PclHintOrange}"
                                Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" Text="{loc:Text Link.NoNodesWarning}" />
                </ContentControl>

                <HeaderedContentControl x:Name="CardHostPlayers" Margin="0,15,0,0" Style="{StaticResource PclCard}">
                    <ScrollViewer MaxHeight="116" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl x:Name="ListHostPlayers" Focusable="False" ItemTemplate="{StaticResource PlayerTemplate}" />
                    </ScrollViewer>
                </HeaderedContentControl>

                <!-- Room tools, one row each: room settings, world backup, voice chat, mod sync and diagnostics. -->
                <HeaderedContentControl Margin="0,15,0,0" Header="{loc:Text Link.Tools}" Style="{StaticResource PclCard}">
                    <StackPanel Margin="0,-5">
                        <Grid Style="{StaticResource ToolRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolIcon}">
                                <Path Style="{StaticResource ToolGlyph}"
                                      Data="M2.5,4.5 L13.5,4.5 M2.5,11.5 L13.5,11.5 M6,2.8 L6,6.2 M10,9.8 L10,13.2" />
                            </Border>
                            <StackPanel Style="{StaticResource ToolText}">
                                <TextBlock FontSize="14" Text="{loc:Text RoomSettings.Label}" />
                                <TextBlock x:Name="LabRoomSettings" Style="{StaticResource ToolState}" />
                            </StackPanel>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Text RoomSettings.Edit}" Click="BtnRoomSettings_Click" />
                        </Grid>
                        <Grid Style="{StaticResource ToolRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolIcon}">
                                <Path Style="{StaticResource ToolGlyph}"
                                      Data="M8,2.2 L13,4 L13,7.6 C13,10.6 10.9,12.8 8,13.8 C5.1,12.8 3,10.6 3,7.6 L3,4 Z M5.8,8 L7.4,9.6 L10.4,6.4" />
                            </Border>
                            <StackPanel Style="{StaticResource ToolText}">
                                <TextBlock FontSize="14" Text="{loc:Text Allowlist.Label}" />
                                <TextBlock x:Name="LabAllowlist" Style="{StaticResource ToolState}" />
                            </StackPanel>
                            <Button x:Name="BtnAllowlist" Style="{StaticResource ToolButton}" Click="BtnAllowlist_Click" />
                        </Grid>
                        <Grid Style="{StaticResource ToolRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolIcon}">
                                <Path Style="{StaticResource ToolGlyph}"
                                      Data="M2.5,3.5 L13.5,3.5 L13.5,6 L2.5,6 Z M3.5,6 L3.5,12.5 L12.5,12.5 L12.5,6 M6.5,8.5 L9.5,8.5" />
                            </Border>
                            <StackPanel Style="{StaticResource ToolText}">
                                <TextBlock FontSize="14" Text="{loc:Text Backup.Label}" />
                                <TextBlock x:Name="LabBackup" Style="{StaticResource ToolState}" />
                            </StackPanel>
                            <Button x:Name="BtnOpenBackup" Style="{StaticResource ToolButton}" Content="{loc:Text Backup.Manage}"
                                    Click="BtnOpenBackup_Click" />
                        </Grid>
                        <Grid Style="{StaticResource ToolRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolIcon}">
                                <Path Style="{StaticResource ToolGlyph}"
                                      Data="M8,2 C9.4,2 10,2.8 10,4 L10,7.5 C10,8.7 9.4,9.5 8,9.5 C6.6,9.5 6,8.7 6,7.5 L6,4 C6,2.8 6.6,2 8,2 Z M3.8,7.2 C3.8,10.2 5.6,11.8 8,11.8 C10.4,11.8 12.2,10.2 12.2,7.2 M8,11.8 L8,14" />
                            </Border>
                            <StackPanel Style="{StaticResource ToolText}">
                                <TextBlock FontSize="14" Text="{loc:Text Voice.Label}" />
                                <TextBlock x:Name="LabHostVoice" Style="{StaticResource ToolState}" />
                            </StackPanel>
                            <Button x:Name="BtnHostVoice" Style="{StaticResource ToolButton}" Click="BtnHostVoice_Click" />
                        </Grid>
                        <Grid Style="{StaticResource ToolRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolIcon}">
                                <Path Style="{StaticResource ToolGlyph}"
                                      Data="M2.8,7 C3.3,4.4 5.4,2.6 8,2.6 C9.9,2.6 11.5,3.6 12.4,5.1 M12.6,2.6 L12.6,5.3 L9.9,5.3 M13.2,9 C12.7,11.6 10.6,13.4 8,13.4 C6.1,13.4 4.5,12.4 3.6,10.9 M3.4,13.4 L3.4,10.7 L6.1,10.7" />
                            </Border>
                            <StackPanel Style="{StaticResource ToolText}">
                                <TextBlock FontSize="14" Text="{loc:Text Mods.Label}" />
                                <TextBlock x:Name="LabModSync" Style="{StaticResource ToolState}" />
                            </StackPanel>
                            <Button x:Name="BtnModSync" Style="{StaticResource ToolButton}" Click="BtnModSync_Click" />
                        </Grid>
                        <Grid Style="{StaticResource ToolRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolIcon}">
                                <Path Style="{StaticResource ToolGlyph}" Data="M2,8.5 L5,8.5 L6.5,4.5 L9.2,12 L10.8,8.5 L14,8.5" />
                            </Border>
                            <StackPanel Style="{StaticResource ToolText}">
                                <TextBlock FontSize="14" Text="{loc:Text Diagnostics.Label}" />
                                <TextBlock x:Name="LabHostDiagnostics" Style="{StaticResource ToolState}" />
                            </StackPanel>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Text Diagnostics.Open}" Click="BtnDiagnostics_Click" />
                        </Grid>
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ======================== List in the lobby (host) ======================== -->
        <DockPanel x:Name="PanPublish" Visibility="Hidden">
            <Grid DockPanel.Dock="Bottom" Margin="0,18,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Content="{loc:Text Link.Back}" Style="{StaticResource PclButton}" Click="BtnPublishBack_Click" />
                    <Button x:Name="BtnPublishConfirm" Margin="12,0,0,0" MinWidth="140" FontWeight="Bold"
                            Content="{loc:Text Lobby.PublishConfirm}" Style="{StaticResource PclButtonHighlight}"
                            Click="BtnPublishConfirm_Click" />
                </StackPanel>
            </Grid>
            <StackPanel>
                <HeaderedContentControl Header="{loc:Text Lobby.PublishHeader}" Style="{StaticResource PclCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock VerticalAlignment="Center" Text="{loc:Text Lobby.Title}" />
                        <Grid Grid.Column="1" Margin="14,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtLobbyTitle" MaxLength="24" Style="{StaticResource PclTextBox}" KeyDown="TxtLobbyTitle_KeyDown" />
                            <!-- The room picture; clicking it picks another one. -->
                            <Button x:Name="BtnLobbyIcon" Grid.Column="1" Margin="8,0,0,0" Width="32" Height="32" Cursor="Hand"
                                    Focusable="False" ToolTip="{loc:Text Lobby.IconPick}" Click="BtnLobbyIconPick_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Button.Template>
                                <Border x:Name="BoxLobbyIcon" CornerRadius="4" Background="{DynamicResource Brush7}">
                                    <!-- A picture frame, shown while the room has none. -->
                                    <Path x:Name="GlyphLobbyIcon" Data="M3,3.5 L13,3.5 L13,12.5 L3,12.5 Z M3.5,11 L6.5,8 L9,10.5 L10.5,9 L12.5,11"
                                          Stroke="{DynamicResource Brush3}" StrokeThickness="1.4" StrokeLineJoin="Round"
                                          Stretch="None" Width="16" Height="16" />
                                </Border>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="14,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LabLobbyWorld" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource BrushGray4}" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal">
                                <Button x:Name="BtnLobbyIconMap" FontSize="12" Style="{StaticResource PclTextButton}"
                                        Content="{loc:Text Lobby.IconMap}" Click="BtnLobbyIconMap_Click" />
                                <Button x:Name="BtnLobbyIconPick" Margin="14,0,0,0" FontSize="12" Style="{StaticResource PclTextButton}"
                                        Click="BtnLobbyIconPick_Click" />
                                <Button x:Name="BtnLobbyIconRemove" Margin="14,0,0,0" FontSize="12" Style="{StaticResource PclTextButton}"
                                        Content="{loc:Text Lobby.IconRemove}" Click="BtnLobbyIconRemove_Click" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="2" Margin="0,12,0,0" VerticalAlignment="Top" Padding="0,6,0,0" Text="{loc:Text Lobby.Description}" />
                        <TextBox x:Name="TxtLobbyDescription" Grid.Row="2" Grid.Column="1" Margin="14,12,0,0" Height="56" MaxLength="100"
                                 TextWrapping="Wrap" AcceptsReturn="False" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource PclTextBox}" Tag="{loc:Text Lobby.DescriptionHint}" />


                        <TextBlock Grid.Row="3" Margin="0,12,0,0" VerticalAlignment="Center" Text="{loc:Text Lobby.Password}" />
                        <TextBox x:Name="TxtLobbyPassword" Grid.Row="3" Grid.Column="1" Margin="14,12,0,0" MaxLength="32"
                                 Style="{StaticResource PclTextBox}" Tag="{loc:Text Lobby.PasswordOptional}" KeyDown="TxtLobbyTitle_KeyDown" />

                        <TextBlock Grid.Row="4" Margin="0,19,0,0" VerticalAlignment="Top" Text="{loc:Text Lobby.Tags}" />
                        <WrapPanel x:Name="PanLobbyTags" Grid.Row="4" Grid.Column="1" Margin="14,14,0,0" />

                        <CheckBox x:Name="ChkLobbyRegion" Grid.Row="5" Grid.Column="1" Margin="14,4,0,0"
                                  Style="{StaticResource PclCheckBox}" Content="{loc:Text Lobby.ShowRegion}" />
                    </Grid>
                </HeaderedContentControl>

                <ContentControl Margin="0,15,0,0" Style="{StaticResource PclHint}">
                    <TextBlock TextWrapping="Wrap" Text="{loc:Text Lobby.PublishNote}" />
                </ContentControl>
            </StackPanel>
        </DockPanel>

        <!-- ======================== Room joined (guest) ======================== -->
        <DockPanel x:Name="PanGuest" Visibility="Hidden">
            <Grid DockPanel.Dock="Bottom" Margin="0,18,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="BtnFavoriteGuest" MinWidth="92" Style="{StaticResource PclButton}"
                            Click="BtnFavorite_Click" />
                    <Button x:Name="BtnLeaveRoom" Margin="12,0,0,0" Content="{loc:Text Link.LeaveRoom}"
                            Style="{StaticResource PclButton}" Click="BtnStop_Click" />
                </StackPanel>
            </Grid>
            <!-- The scroll area reaches past the page margin to take in the card shadows. -->
            <ScrollViewer x:Name="ScrollGuest" Style="{StaticResource RoomScroll}">
            <StackPanel Margin="8,8,8,8">
                <HeaderedContentControl x:Name="CardGuest" Style="{StaticResource PclCard}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource PclHintGreen}">
                            <TextBlock x:Name="LabGuestGuide" TextWrapping="Wrap" />
                        </ContentControl>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Text Link.Address}" />
                                <TextBlock x:Name="LabAddress" Margin="0,2,0,0" FontFamily="{StaticResource FontCode}"
                                           FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush3}" />
                            </StackPanel>
                            <Button x:Name="BtnCopyAddress" Grid.Column="1" MinWidth="128" VerticalAlignment="Center"
                                    Style="{StaticResource PclButton}"
                                    Click="BtnCopyAddress_Click" />
                        </Grid>
                        <UniformGrid Margin="0,14,0,0" Columns="3">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Text Link.Latency}" />
                                <TextBlock x:Name="LabLatency" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Text Link.Path}" />
                                <TextBlock x:Name="LabPath" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Text Link.LocalNetwork}" />
                                <TextBlock x:Name="LabGuestNat" Style="{StaticResource StatValue}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- The host's announcement; hidden while there is none. -->
                <ContentControl x:Name="HintGuestNotice" Margin="0,15,0,0" Style="{StaticResource PclHint}" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap">
                        <Run FontWeight="Bold" Text="{loc:Text Link.Game.Notice}" />
                        <Run x:Name="RunGuestNotice" />
                    </TextBlock>
                </ContentControl>

                <HeaderedContentControl x:Name="CardGuestPlayers" Margin="0,15,0,0" Style="{StaticResource PclCard}">
                    <StackPanel>
                        <ScrollViewer MaxHeight="116" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl x:Name="ListGuestPlayers" Focusable="False" ItemTemplate="{StaticResource PlayerTemplate}" />
                        </ScrollViewer>
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource BrushGray4}"
                                       Text="{loc:Text Link.OfflineTip}" />
                            <ContentControl Style="{StaticResource PclHelp}" ToolTip="{loc:Text Link.OfflineTipDetail}" />
                        </StackPanel>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- Room tools, one row each: the host's voice chat, mod sync and diagnostics. -->
                <HeaderedContentControl Margin="0,15,0,0" Header="{loc:Text Link.Tools}" Style="{StaticResource PclCard}">
                    <StackPanel Margin="0,-5">
                        <Grid Style="{StaticResource ToolRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolIcon}">
                                <Path Style="{StaticResource ToolGlyph}"
                                      Data="M8,2 C9.4,2 10,2.8 10,4 L10,7.5 C10,8.7 9.4,9.5 8,9.5 C6.6,9.5 6,8.7 6,7.5 L6,4 C6,2.8 6.6,2 8,2 Z M3.8,7.2 C3.8,10.2 5.6,11.8 8,11.8 C10.4,11.8 12.2,10.2 12.2,7.2 M8,11.8 L8,14" />
                            </Border>
                            <StackPanel Style="{StaticResource ToolText}">
                                <TextBlock FontSize="14" Text="{loc:Text Voice.Label}" />
                                <TextBlock x:Name="LabGuestVoice" Style="{StaticResource ToolState}" />
                            </StackPanel>
                            <Button x:Name="BtnVoice" Style="{StaticResource ToolButton}" Content="{loc:Text Voice.InstallShort}"
                                    Click="BtnVoice_Click" />
                        </Grid>
                        <Grid Style="{StaticResource ToolRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolIcon}">
                                <Path Style="{StaticResource ToolGlyph}"
                                      Data="M2.8,7 C3.3,4.4 5.4,2.6 8,2.6 C9.9,2.6 11.5,3.6 12.4,5.1 M12.6,2.6 L12.6,5.3 L9.9,5.3 M13.2,9 C12.7,11.6 10.6,13.4 8,13.4 C6.1,13.4 4.5,12.4 3.6,10.9 M3.4,13.4 L3.4,10.7 L6.1,10.7" />
                            </Border>
                            <StackPanel Style="{StaticResource ToolText}">
                                <TextBlock FontSize="14" Text="{loc:Text Mods.Label}" />
                                <TextBlock x:Name="LabMods" Style="{StaticResource ToolState}" />
                            </StackPanel>
                            <Button x:Name="BtnMods" Style="{StaticResource ToolButton}" Content="{loc:Text Mods.SyncShort}"
                                    Click="BtnMods_Click" />
                        </Grid>
                        <Grid Style="{StaticResource ToolRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolIcon}">
                                <Path Style="{StaticResource ToolGlyph}" Data="M2,8.5 L5,8.5 L6.5,4.5 L9.2,12 L10.8,8.5 L14,8.5" />
                            </Border>
                            <StackPanel Style="{StaticResource ToolText}">
                                <TextBlock FontSize="14" Text="{loc:Text Diagnostics.Label}" />
                                <TextBlock x:Name="LabGuestDiagnostics" Style="{StaticResource ToolState}" />
                            </StackPanel>
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Text Diagnostics.Open}" Click="BtnDiagnostics_Click" />
                        </Grid>
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
