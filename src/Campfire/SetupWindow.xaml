<Window x:Class="Campfire.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Campfire.Localization"
        xmlns:controls="clr-namespace:Campfire.Controls"
        Title="Campfire"
        Width="560"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource FontMain}"
        FontSize="13"
        Foreground="{DynamicResource Brush1}"
        UseLayoutRounding="True">

    <!-- Outer margin holds the window shadow. -->
    <Grid Margin="12">
        <Grid IsHitTestVisible="False">
            <Border Margin="-10" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.04" />
            <Border Margin="-9" CornerRadius="15" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.07" />
            <Border Margin="-8" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.11" />
            <Border Margin="-7" CornerRadius="13" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.17" />
            <Border Margin="-6" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.24" />
            <Border Margin="-5" CornerRadius="11" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.32" />
            <Border Margin="-4" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.42" />
            <Border Margin="-3" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.55" />
            <Border Margin="-2" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.7" />
            <Border Margin="-1" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.9" />
        </Grid>
        <Border CornerRadius="6" Background="{DynamicResource BrushBackground}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource BrushTitleBar}" CornerRadius="6,6,0,0" MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:CampfireLogo Width="32" Height="32" Margin="-2,-2,-2,0" />
                        <TextBlock Margin="8,0,0,1" VerticalAlignment="Center" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushWhite}" Text="Campfire" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PclTitleBarButton}"
                            ToolTip="{loc:Text App.Close}" Click="BtnClose_Click">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource BrushWhite}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="22,20,22,18">
                <HeaderedContentControl Header="{loc:Text Storage.Header}" Style="{StaticResource PclCard}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushGray1}" Text="{loc:Text Setup.Note}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtPath" Height="32" IsReadOnly="True" Style="{StaticResource PclTextBox}" />
                            <Button Grid.Column="1" Margin="10,0,0,0" Height="32" MinWidth="96" Style="{StaticResource PclButton}"
                                    Content="{loc:Text Storage.Change}" Click="BtnBrowse_Click" />
                        </Grid>
                        <TextBlock x:Name="LabInfo" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrushGray3}" />
                        <TextBlock x:Name="LabError" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="#D93A3A"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </HeaderedContentControl>

                <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="BtnReset" Height="32" MinWidth="96" Style="{StaticResource PclButton}"
                            Content="{loc:Text Storage.Reset}" Visibility="Collapsed" Click="BtnReset_Click" />
                    <Button Margin="10,0,0,0" Height="32" MinWidth="120" FontWeight="Bold" Style="{StaticResource PclButtonHighlight}"
                            Content="{loc:Text Setup.Start}" Click="BtnStart_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
