<Window x:Class="Campfire.TrayMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Campfire.Localization"
        xmlns:controls="clr-namespace:Campfire.Controls"
        Title="Campfire"
        Width="304"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="-32000"
        Top="-32000"
        Opacity="0"
        FontFamily="{StaticResource FontMain}"
        FontSize="13"
        Foreground="{DynamicResource Brush1}"
        UseLayoutRounding="True"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Geometry x:Key="IconOpen">M2.5,3.5 L13.5,3.5 L13.5,12.5 L2.5,12.5 Z M2.5,6.2 L13.5,6.2</Geometry>
        <Geometry x:Key="IconCreate">M8,3 L8,13 M3,8 L13,8</Geometry>
        <Geometry x:Key="IconJoin">M2.5,8 L9.5,8 M6.5,5 L9.5,8 L6.5,11 M9.5,2.5 L13.5,2.5 L13.5,13.5 L9.5,13.5</Geometry>
        <Geometry x:Key="IconCopy">M5.5,5.5 L12.5,5.5 L12.5,13.5 L5.5,13.5 Z M3.5,10.5 L3.5,2.5 L10.5,2.5</Geometry>
        <Geometry x:Key="IconLeave">M10.5,5 L13.5,8 L10.5,11 M13.5,8 L6.5,8 M8.5,2.5 L2.5,2.5 L2.5,13.5 L8.5,13.5</Geometry>
        <Geometry x:Key="IconExit">M8,2 L8,7.5 M5,4.2 A5.3,5.3 0 1 0 11,4.2</Geometry>

        <!-- A menu entry: icon in Tag, text in Content. Background is the hover tint. -->
        <Style x:Key="TrayItem" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush8}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush1}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="PanHover" Background="{TemplateBinding Background}" CornerRadius="5" Opacity="0" />
                            <Border x:Name="PanPressed" Background="{TemplateBinding Foreground}" CornerRadius="5" Opacity="0" />
                            <StackPanel Margin="10,0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="16" Height="16" Stretch="None" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stroke="{TemplateBinding Foreground}"
                                      Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource HoverIn}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource HoverOut}" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PanPressed" Storyboard.TargetProperty="Opacity"
                                                             To="0.08" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PanPressed" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayDangerItem" TargetType="Button" BasedOn="{StaticResource TrayItem}">
            <Setter Property="Background" Value="{DynamicResource BrushRedLight}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushRed}" />
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource BrushGray4}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- A player: skin face or initial, name and role tag. -->
        <DataTemplate x:Key="PlayerTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="20" Height="20">
                    <Border CornerRadius="3" Background="{DynamicResource Brush7}">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush3}" Text="{Binding Initial}" />
                    </Border>
                    <Image Source="{Binding Head}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill" />
                </Grid>
                <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="2" Margin="8,0,0,0" Padding="5,0" CornerRadius="3" VerticalAlignment="Center"
                        Visibility="{Binding TagVisibility}" Background="{Binding TagBackground}">
                    <TextBlock FontSize="11" Foreground="{Binding TagForeground}" Text="{Binding Tag}" />
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Outer margin leaves room for the shadow outlines. -->
    <Grid x:Name="PanRoot" Margin="12">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>
        <Grid IsHitTestVisible="False">
            <Border Margin="-8" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.05" />
            <Border Margin="-7" CornerRadius="15" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.09" />
            <Border Margin="-6" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.14" />
            <Border Margin="-5" CornerRadius="13" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.2" />
            <Border Margin="-4" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.28" />
            <Border Margin="-3" CornerRadius="11" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.38" />
            <Border Margin="-2" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.52" />
            <Border Margin="-1" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.75" />
        </Grid>
        <Border CornerRadius="8" Background="{DynamicResource BrushBackground}" />

        <StackPanel>
            <!-- ======================== Header ======================== -->
            <Border Background="{DynamicResource BrushTitleBar}" CornerRadius="8,8,0,0" Padding="14,10,14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:CampfireLogo x:Name="Logo" Width="32" Height="32" Margin="-2,-2,-2,0" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Campfire" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushWhite}" />
                        <StackPanel Margin="0,1,0,0" Orientation="Horizontal">
                            <Grid Width="8" Height="8" Margin="0,1,6,0" VerticalAlignment="Center">
                                <Ellipse Fill="{DynamicResource BrushWhite}" />
                                <Ellipse x:Name="DotStatus" Margin="1.5" Fill="{DynamicResource BrushGreen}" />
                            </Grid>
                            <TextBlock x:Name="LabStatus" FontSize="12" Foreground="{DynamicResource BrushWhite}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================== Room ======================== -->
            <Grid x:Name="CardRoom" Margin="8,8,8,0">
                <Grid IsHitTestVisible="False">
                    <Border Margin="-2" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.25" />
                    <Border Margin="-1" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource BrushShadowRing}" Opacity="0.5" />
                </Grid>
                <Border CornerRadius="6" Background="{DynamicResource BrushCard}" />
                <StackPanel Margin="12,10,12,10">
                    <!-- Setting up: the current step. -->
                    <Grid x:Name="PanWorking">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Control Style="{StaticResource PclSpinner}" VerticalAlignment="Center" />
                        <TextBlock x:Name="LabStep" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush3}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="LabStepDetail" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{DynamicResource Brush3}" />
                    </Grid>

                    <!-- Open: the most important value in large type. -->
                    <Grid x:Name="PanHero">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LabHeroCaption" Style="{StaticResource StatLabel}" />
                        <TextBlock x:Name="LabHero" Grid.Row="1" Margin="0,2,0,0" FontSize="15" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="LabHeroSideCaption" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource StatLabel}"
                                   HorizontalAlignment="Right" />
                        <TextBlock x:Name="LabHeroSide" Grid.Row="1" Grid.Column="1" Margin="8,0,0,2" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>

                    <Border x:Name="LineStats" Height="1" Margin="0,10,0,6" Background="{DynamicResource Brush6}" />
                    <Grid x:Name="GridStats">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>

                    <StackPanel x:Name="PanPlayers">
                        <Border Height="1" Margin="0,8,0,8" Background="{DynamicResource Brush6}" />
                        <TextBlock x:Name="LabPlayers" Style="{StaticResource StatLabel}" Margin="0,0,0,2" />
                        <ItemsControl x:Name="ListPlayers" Focusable="False" ItemTemplate="{StaticResource PlayerTemplate}" />
                        <TextBlock x:Name="LabMorePlayers" Margin="28,2,0,0" FontSize="12" Foreground="{DynamicResource BrushGray4}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ======================== Actions ======================== -->
            <StackPanel Margin="6,6,6,6">
                <Button x:Name="BtnOpen" Style="{StaticResource TrayItem}" Tag="{StaticResource IconOpen}"
                        Content="{loc:Text Tray.Open}" Click="BtnOpen_Click" />
                <Button x:Name="BtnCreate" Style="{StaticResource TrayItem}" Tag="{StaticResource IconCreate}"
                        Content="{loc:Text Tray.Create}" Click="BtnCreate_Click" />
                <Button x:Name="BtnJoin" Style="{StaticResource TrayItem}" Tag="{StaticResource IconJoin}"
                        Content="{loc:Text Tray.Join}" Click="BtnJoin_Click" />
                <Button x:Name="BtnCopy" Style="{StaticResource TrayItem}" Tag="{StaticResource IconCopy}"
                        Click="BtnCopy_Click" />
                <Button x:Name="BtnStop" Style="{StaticResource TrayDangerItem}" Tag="{StaticResource IconLeave}"
                        Click="BtnStop_Click" />
                <Border Height="1" Margin="10,4" Background="{DynamicResource Brush6}" />
                <Button x:Name="BtnExit" Style="{StaticResource TrayItem}" Tag="{StaticResource IconExit}"
                        Content="{loc:Text Tray.Exit}" Click="BtnExit_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
